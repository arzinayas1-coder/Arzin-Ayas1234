# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Optional secret for encrypting stored provider credentials.
SESSION_SECRET=""

# Optional Server-Side Model Provider Keys (never exposed to browser)
COARENA_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
NVIDIA_API_KEY=""
APINEX_API_KEY=""
ANYROUTER_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional Supabase Configuration
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
